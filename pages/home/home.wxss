.home-head { display: flex; align-items: center; gap: 12px; padding: 6px 2px 14px; }
.rhine-mini { width: 44px; height: 44px; position: relative; flex: none; }
.rhine-mini .hex { position: absolute; inset: 0; border: 2px solid var(--cyan); transform: rotate(45deg); border-radius: 8px; background: var(--cyan-l); box-shadow: 0 0 14px rgba(31,170,107,.3); }
.rhine-mini .hex2 { position: absolute; inset: 9px; border: 1px solid rgba(31,170,107,.5); transform: rotate(45deg); border-radius: 4px; }
.rhine-mini .core { position: absolute; left: 50%; top: 50%; width: 8px; height: 8px; margin: -4px 0 0 -4px; border-radius: 50%; background: var(--cyan); box-shadow: 0 0 8px var(--cyan); }
.hh-title { font-size: 18px; font-weight: 800; letter-spacing: 2px; }
.hh-en { font-size: 10px; color: var(--text3); letter-spacing: 1px; margin-top: 1px; }

.user-line { background: var(--panel); border: 1px solid var(--line); border-radius: 10px; padding: 9px 12px; margin-bottom: 14px; }
.user-line .u-name { font-weight: 700; color: var(--text); }
.user-line .logout { margin-left: auto; color: var(--text3); font-size: 12px; float: right; }

.grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
.ent { background: var(--panel); border: 1px solid var(--line); border-radius: 14px; padding: 18px 14px; position: relative; overflow: hidden; box-shadow: 0 2px 10px rgba(31,170,107,.05); }
.ent::after { content: ""; position: absolute; left: 0; top: 0; bottom: 0; width: 3px; }
.ent.s::after { background: var(--cyan); box-shadow: 0 0 10px var(--cyan); }
.ent.c::after { background: #36b49a; box-shadow: 0 0 10px #36b49a; }
.ent.t::after { background: var(--blue); box-shadow: 0 0 10px var(--blue); }
.ent.a::after { background: var(--amber); box-shadow: 0 0 10px var(--amber); }
.ent-ic { font-size: 26px; }
.ent-t { font-size: 15px; font-weight: 700; margin-top: 8px; }
.ent-d { font-size: 9px; color: var(--text3); letter-spacing: 1px; margin-top: 1px; }

/* 最终权限 · 中间整卡入口 */
.ent-final {
  display: flex; align-items: center; gap: 12px;
  margin: 12px 0; padding: 16px 16px;
  background: linear-gradient(100deg, #fff 0%, #f3fbf7 60%, #eaf5ff 100%);
  border: 1px solid var(--line); border-left: 4px solid var(--amber);
  border-radius: 14px; position: relative; overflow: hidden;
  box-shadow: 0 2px 12px rgba(232, 146, 58, .12);
}
.ent-final::after {
  content: ""; position: absolute; right: -30px; top: -30px;
  width: 110px; height: 110px; border-radius: 50%;
  background: radial-gradient(circle, rgba(232,146,58,.14), transparent 70%);
}
.ef-lock { font-size: 28px; flex: none; }
.ef-main { flex: 1; }
.ef-t { font-size: 16px; font-weight: 800; letter-spacing: 1px; color: var(--text); }
.ef-d { font-size: 9px; color: var(--text3); letter-spacing: 1px; margin-top: 2px; }
.ef-go { font-size: 22px; color: var(--amber); flex: none; }

.guide view { line-height: 1.95; }

/* 公告栏入口红点 / 未读数徽标 */
.ent-badge {
  display: inline-block; min-width: 16px; height: 16px; line-height: 16px; padding: 0 4px;
  margin-left: 6px; font-size: 10px; color: #fff; background: var(--red);
  border-radius: 999px; vertical-align: middle; text-align: center; font-weight: 700;
}
.ent-dot {
  position: absolute; right: 12px; top: 12px; width: 10px; height: 10px;
  border-radius: 50%; background: var(--red); box-shadow: 0 0 7px var(--red);
}
