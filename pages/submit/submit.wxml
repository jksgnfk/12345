<view class="wrap">
  <!-- 报销人信息 -->
  <view class="card">
    <view class="card-title"><view class="ttbar"></view>报销人信息<span class="en">APPLICANT</span></view>
    <view class="field"><label class="req">姓名</label><view class="val"><input class="pf" value="{{user.username}}" disabled placeholder="见登录信息"/></view></view>
    <view class="field"><label>书院</label><view class="val"><input class="pf" value="{{user.academy}}" disabled/></view></view>
    <view class="field"><label>部门</label><view class="val"><input class="pf" value="{{user.dept}}" disabled/></view></view>
  </view>

  <!-- 报销事项 -->
  <view class="card">
    <view class="card-title"><view class="ttbar"></view>报销事项<span class="en">MATTER</span></view>
    <view class="field">
      <label class="req">报销类型</label>
      <view class="val"><picker mode="selector" range="{{types}}" value="{{typeIndex}}" bindchange="onType"><view class="pf picker-val">{{types[typeIndex]}}</view></picker></view>
    </view>
    <view class="field">
      <label class="req">付款方式</label>
      <view class="val"><picker mode="selector" range="{{pays}}" value="{{payIndex}}" bindchange="onPay"><view class="pf picker-val">{{pays[payIndex]}}</view></picker></view>
    </view>
    <view class="field field-switch">
      <label>含服装采购</label>
      <view class="val"><switch checked="{{clothing}}" bindchange="onClothing" color="#1faa6b"/></view>
    </view>
    <view class="field"><label class="req">报销事由</label><view class="val"><input class="pf" value="{{reason}}" bindinput="onReason" placeholder="如：迎新活动物资采购"/></view></view>
    <view class="field"><label class="req">报销总额</label><view class="val"><input class="pf" type="digit" value="{{total}}" bindinput="onTotal" placeholder="¥0.00"/></view></view>
    <view class="field"><label>备注</label><view class="val"><textarea class="pf" value="{{note}}" bindinput="onNote" placeholder="选填"/></view></view>
  </view>

  <!-- 材料 -->
  <view class="card">
    <view class="card-title"><view class="ttbar"></view>报销材料<span class="en">MATERIALS</span></view>
    <view class="mat-block {{m.required?'req':''}}" wx:for="{{mats}}" wx:key="key" wx:for-item="m">
      <view class="mat-head">
        <view class="mat-name"><text class="dot"></text>{{m.name}}
          <text class="badge {{m.required?'b-req':'b-opt'}}">{{m.required?'必交':'选交'}}</text>
          <text wx:if="{{m.key==='other'}}" class="badge b-spare">备用</text>
        </view>
        <view class="mat-hint mono">{{m.multiple?'多张':'单份'}}</view>
      </view>
      <view class="uploader">
        <view class="file-cell" wx:for="{{m.list}}" wx:key="path" wx:for-item="f" wx:for-index="i">
          <image wx:if="{{f.type==='image'}}" class="thumb" src="{{f.path}}" mode="aspectFill" bindtap="previewImg" data-key="{{m.key}}" data-i="{{i}}"/>
          <view wx:else class="file-card" bindtap="openFile" data-key="{{m.key}}" data-i="{{i}}">
            <text class="file-ext">{{f.ext}}</text>
            <text class="file-name">{{f.name}}</text>
          </view>
          <view class="rm" catchtap="delFile" data-key="{{m.key}}" data-i="{{i}}">×</view>
        </view>
        <view class="add-btn" bindtap="chooseFile" data-key="{{m.key}}" data-multiple="{{m.multiple}}">
          <text class="plus">＋</text><text class="add-t">上传</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 汇总 + 提交 -->
  <view class="card summary">
    <view class="sum-row"><text>报销总额</text><text class="sum-money mono">{{totalFmt}}</text></view>
    <view class="sum-row"><text>已上传材料</text><text class="mono">{{summaryCount}} 项</text></view>
    <button class="btn btn-primary mt12" bindtap="submit">提交报销</button>
  </view>

  <!-- 我的提交记录 -->
  <view class="card mt12">
    <view class="card-title"><view class="ttbar"></view>我的提交记录<span class="en">TRACKING</span></view>
    <view wx:if="{{myList.length===0}}" class="empty">尚未提交任何报销</view>
    <view class="rec-item" wx:for="{{myList}}" wx:key="id" bindtap="openMy" data-id="{{item.id}}">
      <view class="rec-top"><text class="rec-reason">{{item.reason}}</text><text class="rec-stage badge b-spare">{{item.stage}}</text></view>
      <view class="rec-meta mono">{{item.name}} · {{item.type}} · {{item.total}} · 材料{{item.count}}项</view>
    </view>
  </view>
</view>
